              "dic-25",
              "feb-26",
              "ene-25"
            ]
          },
          {
            "name": "Localizaci",
            "type": "string",
            "example": "Municipio: Oruro \nProvincia: Cercado\nDepto.: Oruro \nPROYECTO EN ETAPA DE ESTUDIOS"
          },
          {
            "name": "bbox",
            "type": "object",
            "description": "Extensión de la geometría (xmin, ymin, xmax, ymax). Filtrar por esta columna permite leer solo los grupos de filas que intersectan el área de interés."
          }
        ]
      }
