          },
          {
            "name": "fid",
            "type": "integer",
            "constraints": {
              "minimum": 1,
              "maximum": 6
            }
          },
          {
            "name": "Proyecto",
            "type": "string",
            "example": "PLANTA SOLAR FOTOVOLTAICA VINTO"
          },
          {
            "name": "COD",
            "type": "string",
            "example": "ESTU_03"
          },
          {
            "name": "Inversion",
            "type": "number",
            "constraints": {
              "minimum": 24.0,
              "maximum": 260.1
            }
          },
          {
            "name": "Fuente",
            "type": "string",
            "example": "GESTIÓN DEL FINANCIAMIENTO (AFD, UE)"
          },
          {
            "name": "Avance",
            "type": "number",
            "constraints": {
              "minimum": 0.0985,
              "maximum": 0.38
            }
          },
          {
            "name": "Empresa",
            "type": "string",
            "example": "ENDE Guaracachi S.A.",
