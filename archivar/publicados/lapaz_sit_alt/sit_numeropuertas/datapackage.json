{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "geodatosbolivia_lapaz_sit_alt_sit_numeropuertas",
  "title": "Numero Puertas",
  "description": "Direcciones o números de puertas, obtenido a partir de registros catastrales, números de inmueble, otras fuentes.",
  "sources": [
    {
      "title": "Sistema de Información Territorial del Gobierno Autónomo Municipal de La Paz (alternativo)",
      "path": "http://sitservicios.lapaz.bo/ows38.jsp"
    }
  ],
  "resources": [
    {
      "name": "dataset",
      "type": "table",
      "path": "https://archive.org/download/geodatosbolivia_lapaz_sit_alt_sit_numeropuertas/dataset.geoparquet",
      "format": "parquet",
      "mediatype": "application/vnd.apache.parquet",
      "bytes": 4579996,
      "hash": "sha256:dfa848679d4a626dca5d73ae5449d30c6098db9b3928cb4f7b54bfcf420ab691",
      "schema": {
        "fields": [
          {
            "name": "id",
            "type": "string",
            "constraints": {
              "required": true
            },
            "example": "numeropuertas.12435"
          },
          {
            "name": "cod_sifca",
            "type": "string",
            "example": "031045100010000"
          },
          {
            "name": "num_puerta",
            "type": "string",
            "example": "6023"
          },
          {
            "name": "fuente",
            "type": "string",
            "example": "INE",
            "categories": [
              " ",
              "SERCAT",
              "SIFCA",
              "INE",
              "RUAT",
              "CATASTRO",
              " CATASTRO"
            ]
          },
          {
            "name": "n_inmueble",
            "type": "integer",
            "constraints": {
              "required": true,
              "minimum": 0,
              "maximum": 973866
            }
          },
          {
            "name": "tipo_via",
            "type": "string",
            "example": "Calle",
            "categories": [
              "Calle",
              "Avenida",
              " ",
              "Pasaje Peatonal",
              "Callejón",
              "Pasaje Vehicular",
              "Gradería",
              "Autopista"
            ]
          },
          {
            "name": "nombre_via",
            "type": "string",
            "constraints": {
              "required": true
            },
            "example": "Las Antenas"
          },
          {
            "name": "distrito",
            "type": "integer",
            "constraints": {
              "required": true,
              "minimum": 2,
              "maximum": 21
            }
          },
          {
            "name": "otb",
            "type": "string",
            "example": "Alto Pasankeri Sur"
          },
          {
            "name": "zona",
            "type": "string",
            "example": "Pasankeri"
          },
          {
            "name": "geometry",
            "type": "any",
            "description": "Geometría en WKB, EPSG:4326 (longitud, latitud). Tipos: Point. La fuente declaraba EPSG:4326 pero sus coordenadas estaban en EPSG:32719 (sistema inferido por la ubicación de las geometrías en Bolivia); se reproyectaron."
          },
          {
            "name": "bbox",
            "type": "object",
            "description": "Extensión de la geometría (xmin, ymin, xmax, ymax). Filtrar por esta columna permite leer solo los grupos de filas que intersectan el área de interés."
          }
        ]
      }
    }
  ]
